# FastAPI + CrewAI microservice (agents)
# Reference Dockerfile — NOT tested end-to-end (see docker/README.md).
#
# Build:   docker build -f docker/Dockerfile.agents -t pas-agents .
# Run:     see docker/docker-compose.yml
#
# Note: the current dev tree hardcodes /home/denispy/project-agent-system
# in main.py (sys.path.append) and odoo_tools.py (load_dotenv). When
# running inside the container, use the env vars below and mount the
# .env file at the expected path via docker-compose.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps (kept minimal; litellm/tiktoken may need gcc at install)
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl \
 && rm -rf /var/lib/apt/lists/*

# Python deps first (layer cache friendly)
COPY agent/agents_api/requirements.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

# Application code
COPY agent/ ./agent/
COPY tests/ ./tests/

WORKDIR /app/agent

# Expose FastAPI
EXPOSE 8001

# Health check: FastAPI /health must return HTTP 200
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8001/health || exit 1

# Default: run uvicorn. Override in docker-compose if needed.
CMD ["uvicorn", "agents_api.main:app", "--host", "0.0.0.0", "--port", "8001"]
