<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_monitorization_list" model="ir.ui.view">
        <field name="name">ai.monitorization.list</field>
        <field name="model">ai.monitorization</field>
        <field name="arch" type="xml">
            <list string="Monitorization Logs" create="false" edit="false">
                <field name="timestamp"/>
                <field name="agent_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="status" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
                <field name="execution_time"/>
                <field name="tokens_used"/>
            </list>
        </field>
    </record>

    <record id="view_ai_monitorization_form" model="ir.ui.view">
        <field name="name">ai.monitorization.form</field>
        <field name="model">ai.monitorization</field>
        <field name="arch" type="xml">
            <form string="Monitorization Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="timestamp"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="execution_time"/>
                            <field name="tokens_used"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Log Message">
                            <field name="log_message" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_monitorization" model="ir.actions.act_window">
        <field name="name">Monitorization</field>
        <field name="res_model">ai.monitorization</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
