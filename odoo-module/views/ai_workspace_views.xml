<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_workspace_tree" model="ir.ui.view">
        <field name="name">ai.workspace.tree</field>
        <field name="model">ai.workspace</field>
        <field name="arch" type="xml">
            <list string="Workspaces">
                <field name="name"/>
                <field name="project_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_ai_workspace_form" model="ir.ui.view">
        <field name="name">ai.workspace.form</field>
        <field name="model">ai.workspace</field>
        <field name="arch" type="xml">
            <form string="Workspace">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Mobile Banking App"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Agents">
                            <field name="agent_ids"/>
                        </page>
                        <page string="Chat Sessions">
                            <field name="session_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_workspace" model="ir.actions.act_window">
        <field name="name">Workspaces</field>
        <field name="res_model">ai.workspace</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
