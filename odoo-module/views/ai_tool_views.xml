<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_tool_tree" model="ir.ui.view">
        <field name="name">ai.tool.tree</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <list string="Tools">
                <field name="name"/>
                <field name="tool_type"/>
                <field name="mcp_server_url"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ai_tool_form" model="ir.ui.view">
        <field name="name">ai.tool.form</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <form string="Tool">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. create_jira_issue"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tool_type"/>
                            <field name="mcp_server_url" invisible="tool_type != 'mcp_server'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_tool" model="ir.actions.act_window">
        <field name="name">Tools (MCP)</field>
        <field name="res_model">ai.tool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
