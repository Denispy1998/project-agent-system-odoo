<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- URL Actions -->
        <record id="action_open_chat" model="ir.actions.act_url">
            <field name="name">AI Chat</field>
            <field name="url">/assistente/page</field>
            <field name="target">self</field>
        </record>

        <record id="action_open_dashboard" model="ir.actions.act_url">
            <field name="name">AI Dashboard</field>
            <field name="url">/assistente/dashboard</field>
            <field name="target">self</field>
        </record>

        <record id="action_open_ecosystem" model="ir.actions.act_url">
            <field name="name">AI Ecosystem</field>
            <field name="url">/assistente</field>
            <field name="target">self</field>
        </record>

        <!-- Top-level menu -->
        <menuitem id="menu_ai_root"
                  name="AI Ecosystem"
                  web_icon="meu_assistente_ia,static/description/icon.png"
                  sequence="10"/>

        <menuitem id="menu_ai_home"
                  name="Home"
                  parent="menu_ai_root"
                  action="action_open_ecosystem"
                  sequence="1"/>

        <menuitem id="menu_ai_chat"
                  name="Chat"
                  parent="menu_ai_root"
                  action="action_open_chat"
                  sequence="2"/>

        <menuitem id="menu_ai_dashboard"
                  name="Dashboard"
                  parent="menu_ai_root"
                  action="action_open_dashboard"
                  sequence="3"/>

    </data>
</odoo>
