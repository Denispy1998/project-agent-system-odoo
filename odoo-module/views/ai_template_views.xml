<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_ai_template" model="ir.actions.act_window">
            <field name="name">Agent Templates</field>
            <field name="res_model">ai.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_ai_template_tree" model="ir.ui.view">
            <field name="name">ai.template.tree</field>
            <field name="model">ai.template</field>
            <field name="arch" type="xml">
                <list string="Agent Templates">
                    <field name="name"/>
                    <field name="workspace_id"/>
                    <field name="model_name"/>
                    <field name="temperature"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_ai_template_form" model="ir.ui.view">
            <field name="name">ai.template.form</field>
            <field name="model">ai.template</field>
            <field name="arch" type="xml">
                <form string="Agent Template">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g., Strict Project Manager"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="workspace_id" options="{'no_create': True}"/>
                                <field name="model_name"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="temperature"/>
                                <field name="max_tokens"/>
                                <field name="max_iterations"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Configuration">
                                <group>
                                    <field name="description" placeholder="What is this template used for?"/>
                                </group>
                                <separator string="System Prompt"/>
                                <field name="prompt_template" placeholder="You are an AI assistant specialized in..." nolabel="1"/>
                            </page>
                            <page string="Guardrails (Safety)">
                                <field name="guardrails" placeholder="e.g., Do not delete projects. Only answer in English. Strictly stick to project management." nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
