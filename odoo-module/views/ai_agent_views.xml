<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_agent_tree" model="ir.ui.view">
        <field name="name">ai.agent.tree</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <list string="Agents">
                <field name="name"/>
                <field name="workspace_id"/>
                <field name="template_id"/>
                <field name="state" widget="badge" decoration-success="state=='running'" decoration-info="state=='draft'" decoration-danger="state=='stopped'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ai_agent_form" model="ir.ui.view">
        <field name="name">ai.agent.form</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <form string="Agent">
                <header>
                    <button name="action_start" string="Start" type="object" class="btn-primary" invisible="state=='running'"/>
                    <button name="action_stop" string="Stop" type="object" class="btn-danger" invisible="state!='running'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,stopped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Planning Agent"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="workspace_id"/>
                            <field name="template_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tools">
                            <field name="tool_ids" domain="[('company_id', '=', company_id)]">
                                <list>
                                    <field name="name"/>
                                    <field name="tool_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_agent" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">ai.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
